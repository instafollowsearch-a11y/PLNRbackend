APP_NAME=PLNR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- LOCAL (TEST - Mailpit) ---
# Start Mailpit, then open UI at http://127.0.0.1:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Laravel 12 uses MAIL_SCHEME (not MAIL_ENCRYPTION). Leave encryption unset for Mailpit.
#
# --- PRODUCTION (example SMTP) ---
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=your-user
# MAIL_PASSWORD=your-password
# MAIL_FROM_ADDRESS="noreply@plnr.app"
# MAIL_FROM_NAME="PLNR"
# Alternatives: MAIL_MAILER=ses or MAIL_MAILER=resend with provider credentials.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_URL=https://api.anthropic.com/v1/messages
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Local only: use fake Stripe when STRIPE_SECRET is empty
STRIPE_FAKE=true
BOOKING_FEE_CENTS=999
BOOKING_CURRENCY=usd
BOOKING_OPS_EMAIL=

# Event feeds (Batch 3+)
EVENT_SOURCES=fixture,partiful,posh,groupon
EVENT_FIXTURES_PATH=
EVENTBRITE_TOKEN=
# EVENTBRITE_ORG_ID — reserved for org-scoped Eventbrite queries (not wired yet)
LUMA_API_KEY=
LUMA_API_URL=https://api.lu.ma/public/v1/event/search
ALLEVENTS_API_KEY=
ALLEVENTS_API_URL=https://allevents.in/api/events/list/

# Security & hardening (Batch 5)
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_BOOKING_PER_HOUR=10
# SENTRY_LARAVEL_DSN=
